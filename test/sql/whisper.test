# name: test/sql/whisper.test
# description: Basic tests for whisper extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT whisper_version();
----
Catalog Error: Scalar Function with name whisper_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require whisper

# Test whisper_version function returns expected extension version
query I
SELECT whisper_version() LIKE 'whisper extension v0.6.0 (%';
----
true

# Test whisper_version contains whisper.cpp version
query I
SELECT whisper_version() LIKE '%whisper.cpp:%';
----
true

# Every whisper function overload is documented in duckdb_functions()
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'whisper\_%' ESCAPE '\'
  AND (description IS NULL OR len(examples) = 0 OR len(categories) = 0);
----
0

# No whisper function overload uses placeholder parameter names (col0, col1, ...)
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'whisper\_%' ESCAPE '\'
  AND len(list_filter(parameters, p -> regexp_matches(p, '^col[0-9]+$'))) > 0;
----
0

query T
SELECT parameters FROM duckdb_functions()
WHERE function_name = 'whisper_transcribe_segments' AND len(parameters) = 4 AND parameter_types[1] = 'VARCHAR';
----
[audio, model, language, translate]
