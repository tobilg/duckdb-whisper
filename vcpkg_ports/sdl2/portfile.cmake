vcpkg_check_linkage(ONLY_STATIC_LIBRARY)
vcpkg_from_github(
  OUT_SOURCE_PATH
  SOURCE_PATH
  REPO
  libsdl-org/SDL
  REF
  "release-${VERSION}"
  SHA512
  d5622d6bb7266f7942a7b8ad43e8a22524893bf0c2ea1af91204838d9b78d32768843f6faa248757427b8404b8c6443776d4afa6b672cd8571a4e0c03a829383
)

vcpkg_cmake_configure(
  SOURCE_PATH
  "${SOURCE_PATH}"
  OPTIONS
  -DSDL_SHARED=OFF
  -DSDL_STATIC=ON
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
  -DSDL_AUDIO=ON
  -DSDL_VIDEO=OFF
  -DSDL_RENDER=OFF
  -DSDL_JOYSTICK=OFF
  -DSDL_HAPTIC=OFF
  -DSDL_SENSOR=OFF
  -DSDL_TEST=OFF
  -DSDL_TESTS=OFF
  -DSDL_INSTALL_TESTS=OFF
  -DSDL_LIBSAMPLERATE=OFF
  -DSDL_DBUS=OFF
  -DSDL_IBUS=OFF
  -DSDL_ALSA_SHARED=ON
  -DSDL_PULSEAUDIO_SHARED=ON
  -DSDL_PIPEWIRE_SHARED=ON
  -DSDL_INSTALL_CMAKEDIR=share/sdl2
  -DCMAKE_DISABLE_FIND_PACKAGE_Git=ON)
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(CONFIG_PATH share/sdl2)
vcpkg_fixup_pkgconfig()
file(
  REMOVE_RECURSE
  "${CURRENT_PACKAGES_DIR}/debug/include"
  "${CURRENT_PACKAGES_DIR}/debug/share"
  "${CURRENT_PACKAGES_DIR}/bin"
  "${CURRENT_PACKAGES_DIR}/debug/bin"
  "${CURRENT_PACKAGES_DIR}/share/licenses"
  "${CURRENT_PACKAGES_DIR}/share/aclocal")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE.txt")
